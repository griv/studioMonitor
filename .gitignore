node_modules/
.DS_Store
*.log

# Media is content, not code — large binaries (video especially) don't belong
# in git history. Keep the directory, ignore what's in it.
media/*
!media/.gitkeep

# Runtime state, rewritten by the admin UI. Tracking these guarantees a
# `git pull` conflict on the display machine. Seeded from the .example files.
vibes.json
media-config.json
