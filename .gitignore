node_modules/
.DS_Store
*.log

# Media is content, not code — large binaries (video especially) don't belong
# in git history. Keep the directory, ignore what's in it.
media/*
!media/.gitkeep

# The library. WAL puts -wal and -shm sidecars next to the database, hence a
# directory rather than three entries. This is the rsync target for backups.
data/

# Pre-SQLite runtime state. Kept ignored because the migration renames them to
# .migrated rather than deleting them — the originals survive on the box.
vibes.json
media-config.json
*.migrated
